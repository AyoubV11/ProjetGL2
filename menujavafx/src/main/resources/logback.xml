<configuration>
    <!-- Désactiver les messages de statut de Logback -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    
    <!-- (maintenu mais non utilisé) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Niveaux de log spécifiques pour vos packages -->
    <logger name="com.menu" level="DEBUG" />
    
    <!-- Niveau de log par défaut - AVEC SEULEMENT L'APPENDER FILE -->
    <root level="INFO">
        <!-- Appender console supprimé -->
        <appender-ref ref="FILE" />
    </root>
</configuration>